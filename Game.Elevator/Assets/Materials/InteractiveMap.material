shader: Shaders/InteractiveMap.glsl
surface: Opaque
parameters:
  uMapTexture:
    texture: Textures/Map.png
    filter: Linear
    wrap: Clamp
  uOutlineTexture:
    texture: Textures/Outlines.png
    filter: Linear
    wrap: Clamp
  uMaskTexture:
    texture: Textures/Masks.png
    filter: Nearest
    wrap: Clamp
