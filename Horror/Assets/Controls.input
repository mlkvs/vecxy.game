namespace: Horror
className: HorrorInput

maps:
  - name: Engine
    actions:
      - name: ToggleFullscreen
        type: Button
        bindings:
          - type: Keyboard
            key: F11
      - name: ToggleConsole
        type: Button
        bindings:
          - type: Keyboard
            key: GraveAccent
  - name: Player
    actions:
      - name: Move
        type: Vector2
        bindings:
          - type: Composite
            composite: WASD
      - name: Jump
        type: Button
        bindings:
          - type: Keyboard
            key: Space
      - name: Sprint
        type: Button
        bindings:
          - type: Keyboard
            key: LeftShift
      - name: ReleaseCursor
        type: Button
        bindings:
          - type: Keyboard
            key: Escape
      - name: CaptureCursor
        type: Button
        bindings:
          - type: Mouse
            mouse: Left
          - type: Mouse
            mouse: Right
          - type: Mouse
            mouse: Middle
