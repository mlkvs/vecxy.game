<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>game.vecxy.elevator</ApplicationId>
    <ApplicationTitle>Elevator</ApplicationTitle>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(HOME)/.local/share/android-sdk')">$(HOME)/.local/share/android-sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(HOME)/.local/share/android-jdk')">$(HOME)/.local/share/android-jdk</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Engine\Vecxy.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Game.Elevator\**\*.cs"
             Exclude="..\Game.Elevator\Program.cs;..\Game.Elevator\bin\**;..\Game.Elevator\obj\**"
             LinkBase="Game" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\Engine\Vecxy\Code\Vecxy.Engine\Assets\**\*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\Game.Elevator\Assets\Textures\**\*">
      <Link>Assets\Textures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\Game.Elevator\Assets\Models\**\*">
      <Link>Assets\Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\Game.Elevator\Assets\Materials\**\*">
      <Link>Assets\Materials\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\Game.Elevator\Assets\Shaders\**\*">
      <Link>Assets\Shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
    <AndroidResource Include="..\Game.Elevator\Assets\Textures\Cross.png">
      <Link>Resources\mipmap\appicon.png</Link>
    </AndroidResource>
  </ItemGroup>
</Project>
