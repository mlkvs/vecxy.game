<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <VecxyApplicationId>game.vecxy.hardcorecultivation</VecxyApplicationId>
    <VecxyApplicationTitle Condition="'$(BuildGameName)' == ''">HardCore Cultivation</VecxyApplicationTitle>
    <VecxyApplicationTitle Condition="'$(BuildGameName)' != ''">$(BuildGameName)</VecxyApplicationTitle>
    <VecxyApplicationVersion Condition="'$(BuildGameVersion)' == ''">1.0.0</VecxyApplicationVersion>
    <VecxyApplicationVersion Condition="'$(BuildGameVersion)' != ''">$(BuildGameVersion)</VecxyApplicationVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.45</AssemblyVersion>
    <FileVersion>1.0.0.45</FileVersion>
  </PropertyGroup>

  <Import Project="BuildConfig.props" />

  <!-- Set by ./build or BuildConfig.props; keeps build-only code explicit in C#. -->
  <PropertyGroup Condition="'$(GameBuildFlavor)' == 'Dev'">
    <DefineConstants>$(DefineConstants);GAME_DEV_BUILD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameBuildFlavor)' == 'Release'">
    <DefineConstants>$(DefineConstants);GAME_RELEASE_BUILD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BuildDefines)' != ''">
    <DefineConstants>$(DefineConstants);$(BuildDefines)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(VecxyPlatform)' == 'Android'">
    <BuildIconPath Condition="'$(BuildIconPath)' == ''">$(MSBuildProjectDirectory)/Assets/Textures/Character.png</BuildIconPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public build metadata is available to the game at runtime. Signing credentials are never included. -->
    <AssemblyMetadata Include="BuildPlatform" Value="$(BuildPlatform)" />
    <AssemblyMetadata Include="BuildGameName" Value="$(BuildGameName)" />
    <AssemblyMetadata Include="BuildGameVersion" Value="$(BuildGameVersion)" />
    <AssemblyMetadata Include="BuildGooglePlayVersionCode" Value="$(BuildGooglePlayVersionCode)" />
    <AssemblyMetadata Include="BuildBundleVersion" Value="$(BuildBundleVersion)" />
    <AssemblyMetadata Include="BuildDefines" Value="$(BuildDefines)" />
    <AssemblyMetadata Include="AppMetricaApiKey" Value="$(AppMetricaApiKey)" />
  </ItemGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Android'">
    <PackageReference Include="Net.Android.AppMetrica.Analytics" Version="7.1.1" />
    <AndroidResource Include="$(BuildIconPath)" Link="drawable/app_icon.png" Condition="'$(BuildIconPath)' != ''" />
    <!-- Signing credentials must never be bundled. Analytics.yaml is public app configuration and is read during Android Application.OnCreate. -->
    <AndroidAsset Remove="$(MSBuildProjectDirectory)/Assets/Configs/Build.yaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Android'">
    <Content Remove="Assets/Configs/Build.yaml" />
  </ItemGroup>

  <Import Project="..\Engine\Vecxy\Code\Vecxy.Platforms\build\Vecxy.Platforms.props" />

  <ItemGroup>
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Engine\Vecxy.Engine.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Rendering\Vecxy.Rendering.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Scene\Vecxy.Scene.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Assets\Vecxy.Assets.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Kernel\Vecxy.Kernel.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Diagnostics\Vecxy.Diagnostics.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Physics\Vecxy.Physics.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.UI\Vecxy.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Progression/GameProgress.cs" />
  </ItemGroup>
</Project>
