<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <VecxyApplicationId>game.vecxy.hardcorecultivation</VecxyApplicationId>
    <VecxyApplicationTitle>HardCore Cultivation</VecxyApplicationTitle>
    <VecxyApplicationVersion>1.0.0</VecxyApplicationVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.45</AssemblyVersion>
    <FileVersion>1.0.0.45</FileVersion>
  </PropertyGroup>

  <!-- Set by scripts/build-android.sh; keeps build-only code explicit in C#. -->
  <PropertyGroup Condition="'$(GameBuildFlavor)' == 'Dev'">
    <DefineConstants>$(DefineConstants);GAME_DEV_BUILD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameBuildFlavor)' == 'Release'">
    <DefineConstants>$(DefineConstants);GAME_RELEASE_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Android'">
    <PackageReference Include="Net.Android.AppMetrica.Analytics" Version="7.1.1" />
    <AssemblyMetadata Include="AppMetricaApiKey" Value="$(AppMetricaApiKey)" />
  </ItemGroup>

  <Import Project="..\Engine\Vecxy\Code\Vecxy.Platforms\build\Vecxy.Platforms.props" />

  <ItemGroup>
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Engine\Vecxy.Engine.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Rendering\Vecxy.Rendering.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Scene\Vecxy.Scene.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Assets\Vecxy.Assets.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Kernel\Vecxy.Kernel.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Diagnostics\Vecxy.Diagnostics.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Physics\Vecxy.Physics.csproj" />
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.UI\Vecxy.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Desktop'">
    <ProjectReference Include="..\Engine\Vecxy\Code\Vecxy.Editor\Vecxy.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Progression/GameProgress.cs" />
  </ItemGroup>
</Project>
