# VPack descriptor главного пакета игры.
# Файл лежит непосредственно в Assets/, поэтому он настраивает встроенный пакет Game.
# Сам game.vpack не попадает в итоговый бинарный пакет и не является игровым ассетом.

# Логическое имя пакета и основа стабильного PackageId.
# Для descriptor в корне Assets/ разрешено только имя Game.
name: Game

# Версия содержимого пакета в формате major.minor.patch. Это не версия бинарного VPack format.
version: 1.0.0

# Когда загружать пакет:
#   startup   — автоматически при запуске игры;
#   on-demand — только через await Assets.<Package>.LoadAsync().
# Главный Game всегда обязан быть startup. Для DLC/уровней обычно используется on-demand.
load: startup

# Имена других пакетов, которые должны быть загружены раньше этого пакета.
# Пример для обычного пакета:
# dependencies:
#   - Shared
#   - Localization
# Game не должен зависеть от on-demand DLC, поэтому сейчас список пуст.
dependencies: []

# Remote delivery обычно применяется к DLC/on-demand пакетам, а Game поставляется
# вместе с приложением. Полный шаблон (оставлен комментариями и поэтому выключен):
# remote:
#   # Выберите ровно одно: общий manifest (рекомендуется) или прямой url.
#   manifest: https://cdn.example.com/game/packages.json
#   # url: https://cdn.example.com/{platform}/{name}-{version}.vpack
#   # Для direct URL можно указать ожидаемые байты и SHA-256:
#   # size: 123456789
#   # sha256: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
#   # cache: persistent | session | none
#   cache: persistent
#   # update: manual | check | always
#   update: check
#   integrity: sha256

# Сжатие по умолчанию для платформ без override ниже.
# Короткая форма использует один из готовых profiles:
#   compression: none      # без сжатия;
#   compression: fast      # LZ4;
#   compression: balanced  # Zstd 3 на desktop, Zstd 1 на Android;
#   compression: maximum   # Zstd 12 на desktop, Zstd 6 на Android.
#
# Ниже используется расширенная форма со всеми доступными полями.
compression:
  # Поддерживаемые algorithms: none, lz4, zstd.
  algorithm: zstd

  # Уровень имеет смысл для Zstd: от -5 (быстрее) до 22 (плотнее).
  # Рекомендуемые значения: 1 для Android, 3 для desktop, 12 для maximum desktop.
  level: 3

  # Размер независимо читаемого/распаковываемого блока: b, kb или mb.
  # Рекомендуется 512kb для desktop и 256kb для Android.
  block-size: 512kb

# Platform override имеет приоритет над общей настройкой compression.
# Поддерживаемые ключи платформ: windows, linux, android.
platforms:
  windows:
    # Короткая preset-форма. Здесь maximum означает Zstd level 12 / block 512 KB.
    compression: maximum

  linux:
    # Расширенная форма platform override. Можно задавать algorithm, level и block-size.
    compression:
      algorithm: zstd
      level: 5
      block-size: 512kb

  android:
    # Для release-пакета используем плотное Zstd-сжатие. Уже сжатые OGG и изображения
    # VPack оставляет raw, поэтому дополнительная нагрузка относится в основном к конфигам/UI.
    compression:
      algorithm: zstd
      level: 12
      block-size: 256kb
