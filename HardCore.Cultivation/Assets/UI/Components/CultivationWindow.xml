<panel id="cultivation-window" class="window" hidden="true">
    <panel class="window-header">
        <panel><text class="window-title">Путь</text><text class="window-subtitle">Ступени культивации</text></panel>
        <button class="window-close"><image src="../Textures/UIIcons/close.png" /></button>
    </panel>
    <panel class="path-summary">
        <panel class="path-current-level"><text id="detail-level">1</text></panel>
        <panel class="path-summary-copy"><text class="path-status-kicker">СЕЙЧАС</text><text id="detail-stage" class="path-status-stage">Закалка тела</text><text id="detail-cost" class="path-status-level">Нужно 25 духовной силы</text></panel>
    </panel>
    <panel class="path-progress-row"><panel class="progress-track path-progress"><progress id="detail-progress" class="progress-fill" /></panel><text class="path-progress-end">10</text></panel>
    <panel id="cultivation-path-scroll" class="cultivation-path-scroll" virtualize="true" />
    <panel class="path-actions">
        <button id="detail-advance" class="wide-action">ПОВЫСИТЬ УРОВЕНЬ</button>
        <button id="detail-breakthrough" class="wide-action secondary-wide">СОВЕРШИТЬ ПРОРЫВ</button>
    </panel>
</panel>
