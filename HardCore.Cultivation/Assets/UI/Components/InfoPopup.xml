<panel id="info-popup" class="info-popup-overlay" hidden="true">
    <panel id="info-popup-card" class="info-popup-card">
        <button id="info-popup-close" class="info-popup-close">
            <image sprite="Assets/Textures/GameUIAtlas.atlas#close"/>
        </button>
        <panel id="info-popup-header" class="info-popup-header">
            <panel id="info-popup-icon-well" class="info-popup-icon-well">
                <image id="info-popup-icon" class="info-popup-icon"/>
                <text id="info-popup-contamination" class="contamination-badge" hidden="true">0%</text>
                <panel id="info-popup-quality" class="info-popup-quality item-icon-quality"/>
            </panel>
            <panel class="info-popup-heading">
                <text id="info-popup-kind" class="info-popup-kind">ПРЕДМЕТ</text>
                <text id="info-popup-title" class="info-popup-title">Название</text>
                <panel id="info-popup-element" class="item-element" hidden="true">
                    <image id="info-popup-element-icon" class="item-element-icon"/>
                </panel>
            </panel>
        </panel>
        <panel id="info-popup-body" class="info-popup-body">
            <text id="info-popup-description" class="info-popup-description">Описание</text>
            <text id="info-popup-effect" class="info-popup-effect">Эффект</text>
            <panel id="info-popup-stats" class="info-popup-stats">
                <panel>
                    <text id="info-popup-stat-label-1" class="info-popup-stat-label">ПАРАМЕТР</text>
                    <panel class="info-popup-stat-value-row"><image id="info-popup-price-icon" sprite="Assets/Textures/GameUIAtlas.atlas#money" hidden="true"/><text id="info-popup-stat-value-1" class="info-popup-stat-value">—</text></panel>
                </panel>
                <panel hidden="true">
                    <text id="info-popup-stat-label-2" class="info-popup-stat-label">КАЧЕСТВО</text>
                    <text id="info-popup-stat-value-2" class="info-popup-stat-value" hidden="true">—</text>
                </panel>
                <panel>
                    <text id="info-popup-stat-label-3" class="info-popup-stat-label">ПАРАМЕТР</text>
                    <text id="info-popup-stat-value-3" class="info-popup-stat-value">—</text>
                </panel>
            </panel>
            <text id="info-popup-details" class="info-popup-details">Дополнительная информация</text>
            <panel id="info-popup-actions" class="info-popup-actions">
                <button id="info-popup-use" class="wide-action" hidden="true">ИСПОЛЬЗОВАТЬ</button>
                <button id="info-popup-sell" class="wide-action secondary-wide currency-action" hidden="true"><image sprite="Assets/Textures/GameUIAtlas.atlas#money"/><text>ПРОДАТЬ</text></button>
                <button id="info-popup-ok" class="wide-action">ПОНЯТНО</button>
            </panel>
        </panel>
    </panel>
</panel>
