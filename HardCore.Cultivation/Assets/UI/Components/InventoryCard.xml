<panel class="item-card" data-key="{{key}}">
    <panel class="item-top-row">
        <panel class="item-icon-well"><image class="item-icon" src="{{icon}}" /></panel>
        <panel class="item-heading">
            <text class="item-rarity rarity-badge">{{rarity}}</text>
            <text class="item-name">{{name}}</text>
            <text class="item-meta">{{meta}}</text>
            <panel class="item-quality" />
        </panel>
    </panel>
    <text class="item-description">{{description}}</text>
    <text class="item-effect">{{effect}}</text>
    <panel class="card-action-row"><button class="card-action use-button">ИСПОЛЬЗОВАТЬ</button><button class="card-action secondary sell-button">ПРОДАТЬ · {{price}}</button></panel>
</panel>
