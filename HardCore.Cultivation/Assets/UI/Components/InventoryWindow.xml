<panel id="inventory-window" class="window compact-window inventory-window" hidden="true">
    <panel class="window-header"><panel><text class="window-title">Рюкзак</text><text class="window-subtitle">Нажмите на предмет, чтобы увидеть описание</text></panel><button class="window-close"><image sprite="Assets/Textures/GameUIAtlas.atlas#close" /></button></panel>
    <panel class="window-body">
        <panel class="window-toolbar"><text>ПРЕДМЕТЫ</text><text id="inventory-count" class="toolbar-value">0 предметов</text></panel>
        <panel class="category-tabs">
            <button id="ingredients-tab" class="category-tab active"><image class="tab-brush-stroke" sprite="Assets/Textures/GameUIAtlas.atlas#tab-brush-stroke"/><text>ИНГРЕДИЕНТЫ</text></button>
            <button id="cores-tab" class="category-tab"><image class="tab-brush-stroke" sprite="Assets/Textures/GameUIAtlas.atlas#tab-brush-stroke"/><text>ЯДРА ЗВЕРЕЙ</text></button>
            <button id="pills-tab" class="category-tab"><image class="tab-brush-stroke" sprite="Assets/Textures/GameUIAtlas.atlas#tab-brush-stroke"/><text>ПИЛЮЛИ</text></button>
        </panel>
        <panel id="inventory-grid" class="inventory-grid" virtualize="true" />
        <panel id="inventory-details" class="inventory-details" hidden="true">
            <panel id="inventory-detail-icon-well" class="inventory-detail-icon-well">
                <image id="inventory-detail-icon" />
                <panel id="inventory-detail-quality" class="inventory-detail-quality item-icon-quality" />
            </panel>
            <panel class="inventory-detail-copy">
                <text id="inventory-detail-rarity" class="inventory-detail-rarity">ОБЫЧНАЯ</text>
                <text id="inventory-detail-name" class="inventory-detail-name">Предмет</text>
                <text id="inventory-detail-effect" class="inventory-detail-effect">Описание эффекта</text>
            </panel>
            <panel class="inventory-detail-actions">
                <button id="inventory-use-button" class="compact-action">ИСПОЛЬЗОВАТЬ</button>
                <button id="inventory-sell-button" class="compact-action secondary currency-action"><image sprite="Assets/Textures/GameUIAtlas.atlas#money"/><text>ПРОДАТЬ&#10;+0</text></button>
            </panel>
        </panel>
    </panel>
</panel>
