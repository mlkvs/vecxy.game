<panel class="queue-item" data-key="{{key}}">
    <panel class="queue-number"><text class="queue-number-text">{{number}}</text></panel>
    <panel class="queue-copy"><text class="queue-item-name">{{name}}</text><text class="queue-progress">{{progress}}</text></panel>
    <panel class="queue-controls">
        <button class="queue-control queue-left"><image sprite="Assets/Textures/UIIconsAtlas.atlas#queue-left" /></button>
        <button class="queue-control queue-right"><image sprite="Assets/Textures/UIIconsAtlas.atlas#queue-right" /></button>
        <button class="queue-control queue-remove"><image sprite="Assets/Textures/UIIconsAtlas.atlas#remove" /></button>
    </panel>
</panel>
