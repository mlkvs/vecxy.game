<panel class="mission-card" data-key="{{key}}">
    <text class="mission-card-title">{{name}}</text>
    <text class="mission-card-description">{{description}}</text>
    <panel class="mission-card-footer">
        <panel>
            <text class="mission-duration-value">{{duration}}</text>
            <panel class="mission-reward-line horizontal">
                <image class="mission-rank" sprite="Assets/Textures/MissionRanks.atlas#f" />
                <panel class="mission-reward-icons" />
            </panel>
        </panel>
        <button class="mission-start">ПРИНЯТЬ</button>
    </panel>
</panel>
