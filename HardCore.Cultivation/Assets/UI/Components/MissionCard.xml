<panel class="mission-card" data-key="{{key}}">
    <text class="mission-danger" hidden="true">ОПАСНОСТЬ I</text>
    <text class="mission-card-title">{{name}}</text>
    <text class="mission-card-description">{{description}}</text>
    <panel class="mission-card-footer">
        <panel><text class="mission-duration-value">{{duration}}</text><panel class="mission-reward-icons" /></panel>
        <button class="mission-start">ПРИНЯТЬ</button>
    </panel>
</panel>
