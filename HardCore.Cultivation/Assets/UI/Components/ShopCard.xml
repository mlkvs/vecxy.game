<panel class="shop-card" data-key="{{key}}">
    <panel class="item-icon-well"><image class="item-icon" src="{{icon}}" /></panel>
    <text class="item-name">{{name}}</text>
    <text class="item-meta">{{meta}}</text>
    <text class="item-effect">{{effect}}</text>
    <button class="card-action buy-button">КУПИТЬ · {{price}}</button>
</panel>
