<panel id="alchemy-window" class="window compact-window alchemy-window" hidden="true">
    <panel class="window-header">
        <panel><text class="window-title">Алхимия</text><text class="window-subtitle">Соединяйте свойства и очищайте сырьё</text></panel>
        <button class="window-close"><image sprite="Assets/Textures/GameUIAtlas.atlas#close" /></button>
    </panel>
    <panel class="window-body">
        <panel class="window-tabs alchemy-tabs">
            <button id="alchemy-pill-tab" class="window-tab active"><image class="tab-brush-stroke" sprite="Assets/Textures/GameUIAtlas.atlas#tab-brush-stroke"/><text>АЛХИМИЧЕСКАЯ ПЕЧЬ</text></button>
            <button id="alchemy-distill-tab" class="window-tab"><image class="tab-brush-stroke" sprite="Assets/Textures/GameUIAtlas.atlas#tab-brush-stroke"/><text>РАФИНИРОВАНИЕ</text></button>
        </panel>
        <panel id="alchemy-selection" class="alchemy-selection" />
        <panel class="alchemy-filters">
            <panel class="alchemy-filter-control">
                <button id="alchemy-rarity-filter" class="alchemy-filter-button">Редк.: ВСЕ</button>
                <panel id="alchemy-rarity-menu" class="alchemy-filter-menu" hidden="true" />
            </panel>
            <panel class="alchemy-filter-control">
                <button id="alchemy-quality-filter" class="alchemy-filter-button">Кач.: ВСЕ</button>
                <panel id="alchemy-quality-menu" class="alchemy-filter-menu" hidden="true" />
            </panel>
            <panel class="alchemy-filter-control">
                <button id="alchemy-type-filter" class="alchemy-filter-button">Тип: ВСЕ</button>
                <panel id="alchemy-type-menu" class="alchemy-filter-menu" hidden="true" />
            </panel>
        </panel>
        <panel id="alchemy-ingredients" class="alchemy-ingredients" virtualize="true" />
        <panel class="alchemy-footer">
            <button id="alchemy-craft-button" class="wide-action alchemy-craft" disabled="true">СОЗДАТЬ</button>
        </panel>
    </panel>
</panel>
