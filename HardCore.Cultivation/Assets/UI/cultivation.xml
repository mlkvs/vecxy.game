<ui class="screen"
    styles="cultivation.css"
    scale-mode="scale-with-screen"
    reference-width="450"
    reference-height="900">
    <panel class="top-status">
        <panel class="realm-card">
            <text class="realm-rank">I</text>
            <text class="realm-name">MORTAL</text>
        </panel>

        <panel class="progress-card">
            <panel class="progress-heading">
                <text>BODY REFINING</text>
                <text id="cultivation-value">192.5 / 10000</text>
            </panel>
            <panel class="progress-track">
                <panel class="progress-fill" />
            </panel>
        </panel>

        <panel class="currency-card">
            <text class="currency-gem">STONE</text>
            <text id="spirit-stones" class="currency-value">240</text>
        </panel>
    </panel>

    <panel class="left-rail">
        <button id="profile" class="nav-button red">SOUL</button>
        <button id="sect" class="nav-button red">SECT</button>
        <button id="body" class="nav-button red body-button">BODY</button>
    </panel>

    <panel class="right-rail">
        <button id="manual" class="nav-button green">MANUAL</button>
        <button id="inventory" class="nav-button green">BAG</button>
        <button id="treasure" class="nav-button green">COIN</button>
        <button id="beast" class="nav-button green">BEAST</button>
        <button id="skill" class="nav-button green">SKILL</button>
    </panel>

    <text class="passive-gain">+0.1</text>

    <panel class="bottom-hud">
        <panel class="qi-card">
            <panel class="qi-fill" />
            <text id="qi-value" class="qi-value">22.3 / 30 QI</text>
        </panel>
        <text id="toast" class="toast">TAP THE CULTIVATOR</text>
    </panel>
</ui>
