<ui class="inventory-screen"
    action="modal"
    styles="inventory.css"
    scale-mode="scale-with-screen"
    reference-width="450"
    reference-height="900">
    <panel class="inventory-window" action="modal">
        <panel class="inventory-header">
            <text class="inventory-title">SPIRIT BAG</text>
            <button id="inventory-close" class="close-button">X</button>
        </panel>

        <panel class="inventory-summary">
            <text>ITEM SLOTS</text>
            <text id="inventory-capacity">0 / 100</text>
        </panel>

        <panel class="inventory-grid">
            <button id="slot-0" class="item-slot"><image id="slot-0-icon" class="slot-icon"/><text id="slot-0-quantity" class="slot-quantity"/></button>
            <button id="slot-1" class="item-slot"><image id="slot-1-icon" class="slot-icon"/><text id="slot-1-quantity" class="slot-quantity"/></button>
            <button id="slot-2" class="item-slot"><image id="slot-2-icon" class="slot-icon"/><text id="slot-2-quantity" class="slot-quantity"/></button>
            <button id="slot-3" class="item-slot"><image id="slot-3-icon" class="slot-icon"/><text id="slot-3-quantity" class="slot-quantity"/></button>
            <button id="slot-4" class="item-slot"><image id="slot-4-icon" class="slot-icon"/><text id="slot-4-quantity" class="slot-quantity"/></button>
            <button id="slot-5" class="item-slot"><image id="slot-5-icon" class="slot-icon"/><text id="slot-5-quantity" class="slot-quantity"/></button>
            <button id="slot-6" class="item-slot"><image id="slot-6-icon" class="slot-icon"/><text id="slot-6-quantity" class="slot-quantity"/></button>
            <button id="slot-7" class="item-slot"><image id="slot-7-icon" class="slot-icon"/><text id="slot-7-quantity" class="slot-quantity"/></button>
            <button id="slot-8" class="item-slot"><image id="slot-8-icon" class="slot-icon"/><text id="slot-8-quantity" class="slot-quantity"/></button>
            <button id="slot-9" class="item-slot"><image id="slot-9-icon" class="slot-icon"/><text id="slot-9-quantity" class="slot-quantity"/></button>
            <button id="slot-10" class="item-slot"><image id="slot-10-icon" class="slot-icon"/><text id="slot-10-quantity" class="slot-quantity"/></button>
            <button id="slot-11" class="item-slot"><image id="slot-11-icon" class="slot-icon"/><text id="slot-11-quantity" class="slot-quantity"/></button>
            <button id="slot-12" class="item-slot"><image id="slot-12-icon" class="slot-icon"/><text id="slot-12-quantity" class="slot-quantity"/></button>
            <button id="slot-13" class="item-slot"><image id="slot-13-icon" class="slot-icon"/><text id="slot-13-quantity" class="slot-quantity"/></button>
            <button id="slot-14" class="item-slot"><image id="slot-14-icon" class="slot-icon"/><text id="slot-14-quantity" class="slot-quantity"/></button>
            <button id="slot-15" class="item-slot"><image id="slot-15-icon" class="slot-icon"/><text id="slot-15-quantity" class="slot-quantity"/></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 17</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 18</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 19</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 20</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 21</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 22</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 23</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 24</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 25</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 26</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 27</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 28</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 29</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 30</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 31</text></button>
            <button class="item-slot scroll-demo-slot" disabled="true"><text class="scroll-index">SCROLL 32</text></button>
        </panel>

        <panel class="inventory-footer">
            <button id="inventory-previous" class="page-button">&lt;</button>
            <text id="inventory-page">1 / 1</text>
            <button id="inventory-next" class="page-button">&gt;</button>
            <button id="inventory-sort" class="sort-button">SORT</button>
        </panel>
    </panel>

    <panel id="item-detail" class="item-detail" action="modal" style="display: none">
        <button id="item-detail-close" class="detail-close">X</button>
        <panel class="detail-top">
            <panel class="detail-icon-frame">
                <image id="item-detail-icon" class="detail-icon" />
            </panel>
            <panel class="detail-heading">
                <text id="item-detail-name" class="detail-name">ITEM</text>
                <text id="item-detail-quality" class="detail-quality">COMMON</text>
            </panel>
        </panel>
        <text id="item-detail-description" class="detail-description">DESCRIPTION</text>
        <panel class="detail-price-row">
            <text>SELL PRICE</text>
            <text id="item-detail-price">0</text>
        </panel>
        <button id="item-sell" class="sell-button">SELL ONE</button>
    </panel>
</ui>
