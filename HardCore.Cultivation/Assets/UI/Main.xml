<ui class="screen" styles="Main.css, Styles/Windows.css, Styles/Cards.css"
    scale-mode="fit" reference-width="720" reference-height="1280">
    <panel id="hud">
        <panel class="top-card">
            <panel class="identity-block">
                <text class="eyebrow">ПУТЬ БЕССМЕРТНОГО</text>
                <text id="stage-name" class="screen-title">Закалка тела</text>
            </panel>
            <panel class="calendar-block">
                <text id="year-text" class="calendar-year">ГОД 1</text>
                <text id="tick-text" class="calendar-tick">ТАКТ 0 / 48</text>
            </panel>
        </panel>

        <panel class="resource-row">
            <panel class="resource-card money-resource">
                <panel class="resource-icon-shell"><image class="resource-icon" src="../Textures/UIIcons/money.png" /></panel>
                <panel class="resource-copy"><text class="resource-label">МОНЕТЫ</text><text id="money-text" class="resource-value">1000</text></panel>
            </panel>
            <panel class="resource-card spirit-resource">
                <panel class="resource-icon-shell"><image class="resource-icon" src="../Textures/UIIcons/spirit.png" /></panel>
                <panel class="resource-copy"><text class="resource-label">ДУХОВНАЯ СИЛА</text><text id="spirit-text" class="resource-value">0</text></panel>
            </panel>
            <panel class="resource-card age-resource">
                <panel class="resource-icon-shell"><image class="resource-icon" src="../Textures/UIIcons/age.png" /></panel>
                <panel class="resource-copy"><text class="resource-label">ВОЗРАСТ / ПРЕДЕЛ</text><text id="age-text" class="resource-value">16 / 80</text></panel>
            </panel>
        </panel>

        <panel class="character-space">
            <button id="character-tap-target" class="character-tap-target" aria-label="Медитировать" />
            <panel class="mission-float glass-panel">
                <panel class="float-heading"><image src="../Textures/UIIcons/missions.png" /><text>ТЕКУЩАЯ МИССИЯ</text></panel>
                <text id="mission-name" class="float-title">Нет активной миссии</text>
                <text id="mission-description" class="float-description">Выберите поручение.</text>
                <panel class="progress-track"><progress id="mission-progress" class="progress-fill mission-fill" /></panel>
                <text id="mission-progress-text" class="progress-caption">0 / 0</text>
            </panel>

            <panel class="side-tools">
                <panel class="effects-float">
                    <text class="small-heading">ЭФФЕКТЫ</text>
                    <panel id="effects-list" class="effects-list"><text class="muted-text">Нет эффектов</text></panel>
                </panel>
            </panel>
        </panel>

        <panel class="cultivation-bar">
            <panel class="cultivation-copy">
                <panel class="float-heading"><image src="../Textures/UIIcons/cultivation.png" /><text>КУЛЬТИВАЦИЯ</text></panel>
                <text id="realm-text" class="cultivation-title">Закалка тела · 1</text>
                <text id="cultivation-cost" class="cultivation-cost">До уровня: 25 ци</text>
                <panel class="progress-track"><progress id="cultivation-progress" class="progress-fill" /></panel>
            </panel>
            <panel class="cultivation-actions">
                <button id="advance-button" class="primary-button">ПОВЫСИТЬ УРОВЕНЬ</button>
                <button id="breakthrough-button" class="secondary-button">ПРОРЫВ</button>
            </panel>
        </panel>

        <panel class="bottom-nav">
            <button id="shop-button" class="nav-button"><panel class="nav-icon-shell"><image src="../Textures/UIIcons/shop.png" /></panel><text>ЛАВКА</text></button>
            <button id="inventory-button" class="nav-button"><panel class="nav-icon-shell"><image src="../Textures/UIIcons/inventory.png" /></panel><text>РЮКЗАК</text></button>
            <button id="cultivation-button" class="nav-button"><panel class="nav-icon-shell"><image src="../Textures/UIIcons/cultivation.png" /></panel><text>ПУТЬ</text></button>
            <button id="missions-button" class="nav-button"><panel class="nav-icon-shell"><image src="../Textures/UIIcons/missions.png" /></panel><text>МИССИИ</text></button>
        </panel>
    </panel>
    <panel id="window-layer" />
</ui>
