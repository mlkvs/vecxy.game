<ui class="screen" styles="Main.css, Styles/Cards.css"
    scale-mode="fit" reference-width="620" reference-height="1180">
    <panel id="hud">
        <panel class="top-card">
            <panel class="top-stat horizontal money-stat">
                <panel class="top-stat-icon-shell"><image class="top-stat-icon" sprite="Assets/Textures/GameUIAtlas.atlas#money" /></panel>
                <panel class="top-stat-copy"><text class="top-stat-label">БАЛАНС</text><text id="money-text" class="top-stat-value">1000</text></panel>
            </panel>
            <panel class="top-stat horizontal">
                <panel class="top-stat-icon-shell age"><image class="top-stat-icon" sprite="Assets/Textures/GameUIAtlas.atlas#age" /></panel>
                <panel class="top-stat-copy">
                    <text class="top-stat-label">ВОЗРАСТ</text>
                    <panel class="age-values">
                        <text id="age-text" class="top-stat-value">16</text>
                        <text class="top-stat-value age-separator">/</text>
                        <text id="maximum-age-text" class="top-stat-value age-maximum">80</text>
                    </panel>
                </panel>
            </panel>
            <panel class="calendar-slot">
                <panel class="calendar-dial year-candle">
                    <image class="year-candle-holder year-candle-holder-back" sprite="Assets/Textures/GameUIAtlas.atlas#year-candle-holder" />
                    <progress id="year-candle-wax" class="year-candle-wax" direction="vertical-bottom" sprite="Assets/Textures/GameUIAtlas.atlas#year-candle-body" />
                    <image id="year-candle-cap" class="year-candle-cap" sprite="Assets/Textures/GameUIAtlas.atlas#year-candle-cap" />
                    <image class="year-candle-holder year-candle-holder-front" sprite="Assets/Textures/GameUIAtlas.atlas#year-candle-holder-front" />
                    <image id="year-candle-flame" class="year-candle-flame" sprite="Assets/Textures/GameUIAtlas.atlas#year-candle-flame-0" />
                </panel>
            </panel>
        </panel>

        <panel class="character-space">
            <button id="character-tap-target" class="character-tap-target" aria-label="Медитировать" />
            <button id="dog-tap-target" class="dog-tap-target" aria-label="Погладить питомца" />
            <button id="mission-summary-button" class="mission-float glass-panel">
                <panel class="float-heading"><image sprite="Assets/Textures/GameUIAtlas.atlas#missions" /><text>ТЕКУЩАЯ МИССИЯ</text></panel>
                <panel id="mission-danger-indicator" class="mission-danger-indicator" hidden="true">
                    <text id="mission-difficulty" class="mission-difficulty">НАРАВНЕ</text>
                </panel>
                <text id="mission-name" class="float-title">Нет активной миссии</text>
                <panel id="mission-normal-state">
                    <text id="mission-description" class="float-description">Выберите поручение.</text>
                    <panel class="progress-track mission-progress-track">
                        <progress id="mission-progress" class="progress-fill mission-fill" />
                        <panel id="mission-combat-marker" class="mission-combat-marker" hidden="true" />
                    </panel>
                    <text id="mission-progress-text" class="progress-caption">0 / 0</text>
                </panel>
                <panel id="mission-combat-state" hidden="true">
                    <panel class="combat-preview-shell">
                        <image id="mission-combat-preview" class="mission-combat-preview" />
                        <panel class="combatant-stats combatant-stats-hero">
                            <panel><image sprite="Assets/Textures/GameUIAtlas.atlas#combat-attack"/><text id="combat-hero-attack-stat">0</text></panel>
                            <panel><image sprite="Assets/Textures/GameUIAtlas.atlas#combat-defense"/><text id="combat-hero-defense-stat">0</text></panel>
                            <panel><image sprite="Assets/Textures/GameUIAtlas.atlas#combat-speed"/><text id="combat-hero-speed-stat">0</text></panel>
                        </panel>
                        <panel class="combatant-stats combatant-stats-enemy">
                            <panel><image sprite="Assets/Textures/GameUIAtlas.atlas#combat-attack"/><text id="combat-enemy-attack-stat">0</text></panel>
                            <panel><image sprite="Assets/Textures/GameUIAtlas.atlas#combat-defense"/><text id="combat-enemy-defense-stat">0</text></panel>
                            <panel><image sprite="Assets/Textures/GameUIAtlas.atlas#combat-speed"/><text id="combat-enemy-speed-stat">0</text></panel>
                        </panel>
                        <text id="combat-hero-damage" class="combat-damage-float combat-hero-damage" animation-trigger="manual">-0</text>
                        <text id="combat-enemy-damage" class="combat-damage-float combat-enemy-damage" animation-trigger="manual">-0</text>
                    </panel>
                    <panel class="progress-track combat-health-track"><progress id="enemy-health-progress" class="progress-fill health-fill" /></panel>
                    <text id="enemy-health-text" class="progress-caption">0 / 0</text>
                </panel>
            </button>
            <panel class="side-tools">
                <panel id="effects-list" class="effects-list" />
            </panel>
            <button id="activity-mode-button" class="activity-toggle">
                <panel class="activity-toggle-icon-shell"><image id="activity-mode-icon" sprite="Assets/Textures/GameUIAtlas.atlas#cultivation" /></panel>
                <text id="activity-mode-text">КУЛЬТИВАЦИЯ</text>
            </button>
        </panel>

        <panel class="bottom-hud-panel">
            <panel class="cultivation-bar">
                <panel class="cultivation-copy">
                    <text id="realm-text" class="cultivation-title">Закалка тела · ур. 1</text>
                    <panel class="progress-track cultivation-track">
                        <progress id="cultivation-progress" class="progress-fill" />
                        <progress id="cultivation-overflow-progress" class="progress-fill cultivation-overflow-fill" />
                        <text id="cultivation-progress-text" class="cultivation-progress-text">0 / 25</text>
                    </panel>
                    <panel class="progress-track hero-health-track">
                        <progress id="hero-health-progress" class="progress-fill health-fill" />
                        <panel id="hero-recovery-threshold" class="hero-recovery-threshold" hidden="true" />
                        <text id="hero-health-text" class="cultivation-progress-text">100 / 100</text>
                    </panel>
                    <panel class="progress-track hero-contamination-track">
                        <progress id="hero-contamination-progress" class="progress-fill contamination-fill" />
                        <text id="hero-contamination-text" class="cultivation-progress-text">0%</text>
                    </panel>
                </panel>
                <button id="breakthrough-button" class="secondary-button">ПРОРЫВ</button>
            </panel>

            <panel class="bottom-nav">
                <button id="shop-button" class="nav-button"><panel class="nav-icon-shell"><image sprite="Assets/Textures/GameUIAtlas.atlas#shop" /></panel><text>ЛАВКА</text></button>
                <button id="alchemy-button" class="nav-button"><panel class="nav-icon-shell"><image sprite="Assets/Textures/GameUIAtlas.atlas#alchemy" /></panel><text>АЛХИМИЯ</text></button>
                <button id="inventory-button" class="nav-button"><panel class="nav-icon-shell"><image sprite="Assets/Textures/GameUIAtlas.atlas#inventory" /></panel><text>РЮКЗАК</text></button>
            </panel>
        </panel>
    </panel>
</ui>
