<ui class="screen" styles="Main.css, Styles/Windows.css, Styles/Cards.css"
    scale-mode="fit" reference-width="620" reference-height="1180">
    <panel id="hud">
        <panel class="top-card">
            <panel class="top-stat horizontal">
                <panel class="top-stat-icon-shell"><image class="top-stat-icon" sprite="Assets/Textures/UIIconsAtlas.atlas#money" /></panel>
                <panel class="top-stat-copy"><text class="top-stat-label">РУБЛИ</text><text id="money-text" class="top-stat-value">1000</text></panel>
            </panel>
            <panel class="top-stat horizontal">
                <panel class="top-stat-icon-shell age"><image class="top-stat-icon" sprite="Assets/Textures/UIIconsAtlas.atlas#age" /></panel>
                <panel class="top-stat-copy">
                    <text class="top-stat-label">ВОЗРАСТ</text>
                    <panel class="age-values">
                        <text id="age-text" class="top-stat-value">16</text>
                        <text class="top-stat-value age-separator">/</text>
                        <text id="maximum-age-text" class="top-stat-value age-maximum">80</text>
                    </panel>
                </panel>
            </panel>
            <panel class="calendar-slot">
                <panel class="calendar-dial">
                    <radial-progress id="year-dial" class="calendar-ring" clockwise-depletion="true" />
                    <image sprite="Assets/Textures/UIIconsAtlas.atlas#age" />
                </panel>
            </panel>
        </panel>

        <panel class="character-space">
            <button id="character-tap-target" class="character-tap-target" aria-label="Медитировать" />
            <button id="dog-tap-target" class="dog-tap-target" aria-label="Погладить питомца" />
            <button id="mission-summary-button" class="mission-float glass-panel">
                <panel class="float-heading"><image sprite="Assets/Textures/UIIconsAtlas.atlas#missions" /><text>ТЕКУЩАЯ МИССИЯ</text></panel>
                <text id="mission-name" class="float-title">Нет активной миссии</text>
                <panel id="mission-normal-state">
                    <text id="mission-description" class="float-description">Выберите поручение.</text>
                    <panel class="progress-track"><progress id="mission-progress" class="progress-fill mission-fill" /></panel>
                    <text id="mission-progress-text" class="progress-caption">0 / 0</text>
                </panel>
                <panel id="mission-combat-state" hidden="true">
                    <panel class="combat-preview-shell">
                        <image id="mission-combat-preview" class="mission-combat-preview" />
                        <text id="combat-hero-damage" class="combat-damage-float combat-hero-damage" animation-trigger="manual">-0</text>
                        <text id="combat-enemy-damage" class="combat-damage-float combat-enemy-damage" animation-trigger="manual">-0</text>
                    </panel>
                    <text id="mission-combat-status" class="mission-combat-status">АВТОБОЙ</text>
                    <text id="mission-combat-stats" class="mission-combat-stats">АТК 0 · ЗАЩ 0 · СКОР 0/с</text>
                    <panel class="progress-track combat-health-track"><progress id="enemy-health-progress" class="progress-fill health-fill" /></panel>
                    <text id="enemy-health-text" class="progress-caption">0 / 0</text>
                </panel>
            </button>
            <panel class="side-tools">
                <panel id="effects-list" class="effects-list" />
            </panel>
            <button id="activity-mode-button" class="activity-toggle">
                <panel class="activity-toggle-icon-shell"><image id="activity-mode-icon" sprite="Assets/Textures/UIIconsAtlas.atlas#cultivation" /></panel>
                <text id="activity-mode-text">КУЛЬТИВАЦИЯ</text>
            </button>
        </panel>

        <panel class="cultivation-bar">
            <panel class="cultivation-copy">
                <text id="realm-text" class="cultivation-title">Закалка тела · ур. 1</text>
                <panel class="progress-track cultivation-track">
                    <progress id="cultivation-progress" class="progress-fill" />
                    <progress id="cultivation-overflow-progress" class="progress-fill cultivation-overflow-fill" />
                    <text id="cultivation-progress-text" class="cultivation-progress-text">0 / 25</text>
                </panel>
                <panel class="progress-track hero-health-track">
                    <progress id="hero-health-progress" class="progress-fill health-fill" />
                    <panel id="hero-recovery-threshold" class="hero-recovery-threshold" hidden="true" />
                    <text id="hero-health-text" class="cultivation-progress-text">120 / 120</text>
                </panel>
            </panel>
            <button id="breakthrough-button" class="secondary-button">ПРОРЫВ</button>
        </panel>

        <panel class="bottom-nav">
            <button id="shop-button" class="nav-button"><panel class="nav-icon-shell"><image sprite="Assets/Textures/UIIconsAtlas.atlas#shop" /></panel><text>ЛАВКА</text></button>
            <button id="alchemy-button" class="nav-button"><panel class="nav-icon-shell"><image sprite="Assets/Textures/UIIconsAtlas.atlas#alchemy" /></panel><text>АЛХИМИЯ</text></button>
            <button id="inventory-button" class="nav-button"><panel class="nav-icon-shell"><image sprite="Assets/Textures/UIIconsAtlas.atlas#inventory" /></panel><text>РЮКЗАК</text></button>
        </panel>
    </panel>
    <panel id="window-layer">
        <panel id="window-backdrop" hidden="true" />
    </panel>
</ui>
