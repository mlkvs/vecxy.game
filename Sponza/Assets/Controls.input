namespace: Sponza
className: SponzaInput

maps:
  - name: Engine
    actions:
      - name: ToggleFullscreen
        type: Button
        bindings:
          - type: Keyboard
            key: F11
      - name: ToggleConsole
        type: Button
        bindings:
          - type: Keyboard
            key: GraveAccent
  - name: Camera
    actions:
      - name: Move
        type: Vector2
        bindings:
          - type: Composite
            composite: WASD
      - name: Up
        type: Button
        bindings:
          - type: Keyboard
            key: E
          - type: Keyboard
            key: Space
      - name: Down
        type: Button
        bindings:
          - type: Keyboard
            key: Q
          - type: Keyboard
            key: LeftControl
      - name: Sprint
        type: Button
        bindings:
          - type: Keyboard
            key: LeftShift
      - name: ReleaseCursor
        type: Button
        bindings:
          - type: Keyboard
            key: Escape
      - name: CaptureCursor
        type: Button
        bindings:
          - type: Mouse
            mouse: Left
          - type: Mouse
            mouse: Right
          - type: Mouse
            mouse: Middle
