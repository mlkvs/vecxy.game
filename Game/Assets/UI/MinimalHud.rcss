body {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 28 28 24 28;
}

healthbar {
    width: 28%;
    min-width: 220;
    max-width: 360;
    height: 38;
    margin-top: auto;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 0;
    padding: 0 0 0 0;
    background: #081018A8;
    fill-color: #945ced;
    track-color: #2B3642D0;
    radius: 14;
    shadow-color: #00000038;
    shadow-offset-y: 4;
}

.version-label {
    margin-top: 8;
    align-self: flex-end;
    text-align: right;
    text-color: #FFFFFFC8;
    font-size: 16;
}
