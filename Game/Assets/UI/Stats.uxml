<UI>
    <Panel class="stats">
        <Label class="title" text="RENDER STATS" />
        <Label id="fps" /><Label id="draws" /><Label id="triangles" />
        <Label id="objects" /><Label id="instancing" /><Label id="static" />
    </Panel>

    <Panel class="controls-panel">
        <Label class="title" text="CONTROLS" />
        <ScrollView class="controls-scroll">
            <Button text="PLAY" /><Button text="SETTINGS" /><Button text="QUIT" />
            <Toggle value="1" /><Slider value="0.35" /><ProgressBar value="0.8" />
            <TextField text="PLAYER NAME" />
            <Dropdown text="HIGH" options="LOW|MEDIUM|HIGH|ULTRA" />
            <RadioButton text="WINDOWED" value="1" />
            <RadioButton text="FULLSCREEN" />
        </ScrollView>
    </Panel>

    <Panel class="crosshair">
        <Panel class="crosshair-horizontal" />
        <Panel class="crosshair-vertical" />
    </Panel>

    <Panel class="health-panel">
        <Panel class="health-header">
            <Label text="HEALTH" />
            <Label id="health-value" class="right-text" />
        </Panel>
        <ProgressBar id="health" value="1" />
        <Slider class="demo-slider" value="0.65" />
    </Panel>

    <Panel class="inventory">
        <Label class="inventory-title" text="INVENTORY" />
        <Panel class="slots">
            <Button class="slot selected" text="1" draggable="true" drop-target="true" />
            <Button class="slot" text="2" draggable="true" drop-target="true" />
            <Button class="slot" text="3" draggable="true" drop-target="true" />
            <Button class="slot" text="4" draggable="true" drop-target="true" />
            <Button class="slot" text="5" draggable="true" drop-target="true" />
            <Button class="slot" text="6" draggable="true" drop-target="true" />
        </Panel>
        <Panel class="control-row">
            <Toggle value="1" /><Label text="AUTO USE" />
            <TextField text="SEARCH..." />
        </Panel>
    </Panel>
</UI>